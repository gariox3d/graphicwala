{
  "rewrites": [
    {
      "source": "/",
      "destination": "https://haeggvlmnfapopmyuaya.supabase.co/functions/v1/og-meta?path=/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebookcatalog|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|embedly|quora|outbrain|redditbot|vkshare).*"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://haeggvlmnfapopmyuaya.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/category/:slug",
      "destination": "https://haeggvlmnfapopmyuaya.supabase.co/functions/v1/og-meta?path=/category/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebookcatalog|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|embedly|quora|outbrain|redditbot|vkshare).*"
        }
      ]
    },
    {
      "source": "/product/:id",
      "destination": "https://haeggvlmnfapopmyuaya.supabase.co/functions/v1/og-meta?id=:id&path=/product/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebookcatalog|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterest|embedly|quora|outbrain|redditbot|vkshare).*"
        }
      ]
    },
    {
      "source": "/share/product/:id",
      "destination": "https://haeggvlmnfapopmyuaya.supabase.co/functions/v1/og-meta?id=:id&path=/product/:id"
    },
    {
      "source": "/api/supabase/:path*",
      "destination": "https://haeggvlmnfapopmyuaya.supabase.co/:path*"
    },
    {
      "source": "/sofiya-weds-wasid",
      "destination": "/sofiya-weds-wasid/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/((?!assets/|.*\\.(?:js|css|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2|ttf|txt|xml|json)$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
